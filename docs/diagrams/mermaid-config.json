{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, 'Liberation Sans', sans-serif",
    "fontSize": "15px",
    "background": "#fcfcfb",
    "primaryColor": "#f1f0ec",
    "primaryTextColor": "#0b0b0b",
    "primaryBorderColor": "#8a8985",
    "secondaryColor": "#e7f0fb",
    "tertiaryColor": "#fcfcfb",
    "lineColor": "#52514e",
    "textColor": "#0b0b0b",
    "clusterBkg": "#f7f6f3",
    "clusterBorder": "#c9c8c3",
    "edgeLabelBackground": "#fcfcfb",
    "noteBkgColor": "#fcfcfb",
    "noteTextColor": "#0b0b0b",
    "noteBorderColor": "#8a8985",
    "actorBkg": "#e7f0fb",
    "actorBorder": "#2a78d6",
    "actorTextColor": "#0b0b0b",
    "actorLineColor": "#8a8985",
    "signalColor": "#52514e",
    "signalTextColor": "#0b0b0b",
    "labelBoxBkgColor": "#f1f0ec",
    "labelBoxBorderColor": "#8a8985",
    "labelTextColor": "#0b0b0b",
    "loopTextColor": "#0b0b0b",
    "activationBkgColor": "#e7f0fb",
    "activationBorderColor": "#2a78d6",
    "sequenceNumberColor": "#fcfcfb"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "nodeSpacing": 34,
    "rankSpacing": 44,
    "padding": 14,
    "useMaxWidth": false,
    "wrappingWidth": 560
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": true,
    "actorMargin": 60,
    "messageMargin": 34,
    "boxMargin": 8,
    "noteMargin": 10,
    "wrap": false,
    "noteAlign": "center"
  },
  "securityLevel": "strict",
  "markdownAutoWrap": false,
  "htmlLabels": false
}
