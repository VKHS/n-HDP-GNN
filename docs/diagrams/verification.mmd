    E1("`job log: tests passed, failed
and skipped, with the reasons`"):::out
    PT --> TW --> E1
  end

  subgraph R2["Smoke check  ·  does the whole pipeline run end to end, in minutes"]
    direction LR
    SM("`**scripts/smoke.py**  ·  make smoke, make smoke-full
